{
  "name": "agriconnect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "emulators:import": "firebase emulators:start --import=./emulator-data",
    "prepare": "husky",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:rules": "node scripts/test-rules.mjs",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm test && npm run build && npm --prefix functions run build",
    "verify:all": "npm run verify && npm run test:rules"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7",
    "lucide-react": "1.23.0",
    "firebase": "12.15.0",
    "zod": "4.4.3",
    "zustand": "5.0.8",
    "react-hook-form": "7.62.0",
    "@hookform/resolvers": "5.2.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.24",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.0",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "firebase-tools": "15.22.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "vitest": "3.2.7",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.8.0",
    "@firebase/rules-unit-testing": "5.0.0"
  },
  "overrides": {
    "@google-cloud/cloud-sql-connector": "1.9.0"
  }
}

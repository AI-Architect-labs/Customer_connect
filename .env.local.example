# Copy this file to .env.local and fill in real values from your Firebase project's
# Web App configuration (Firebase Console → Project Settings → General → Your apps).
# .env.local is gitignored and must never be committed with real values.
#
# These NEXT_PUBLIC_* values are the Firebase Web SDK's public client configuration
# (not secret credentials — Firebase's security model relies on Security Rules, not
# on hiding this config; see Architecture.md §7). They are still kept out of source
# control as a matter of environment-per-deployment hygiene, not because they are
# sensitive secrets.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" for local development against the Firebase Local Emulator Suite.
# When true, the Firebase config values above are not required (safe dummy values
# are used instead) since the emulator does not authenticate against a real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Storefront configuration
NEXT_PUBLIC_DEFAULT_SHOP_ID=demo-shop

# Optional for owner browser push notifications. Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional until Firebase App Check is configured. Required before production hardening.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
